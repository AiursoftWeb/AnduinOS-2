{
  "schema_version": 1,
  "fatal_message_patterns": [
    "\\bsegfault\\b",
    "core dumped",
    "\\boom-kill\\b",
    "out of memory:",
    "kernel panic",
    "JS ERROR",
    "extension.*(error|exception)",
    "assertion .* failed",
    "Traceback \\(most recent call last\\)",
    "(^|\\s)fatal(:|\\s+(error|failure))"
  ],
  "known_diagnostics": [
    {
      "id": "gdm-autologin-keyring-locked",
      "component_regex": "gdm-(autologin|session-worker)",
      "message_regex": "^gkr-pam: couldn't unlock the login keyring\\.?$",
      "conditions": {
        "automatic_login": true
      },
      "max_occurrences": 1,
      "package": "gdm3",
      "version_glob": "50.*",
      "owner": "GNOME/GDM",
      "reason": "Automatic login supplies no account password to PAM, so a password-protected login keyring remains locked. The test separately proves that the keyring daemon and desktop session are healthy."
    },
    {
      "id": "gnome50-keyboard-null-variant",
      "component_regex": "(^|/)gsd-keyboard($|[|/])",
      "message_regex": "^g_variant_unref: assertion 'value != NULL' failed$",
      "conditions": {
        "desktop_release_gate": true,
        "rime": true
      },
      "max_occurrences": 1,
      "package": "gnome-settings-daemon",
      "version_glob": "50.*",
      "owner": "GNOME Settings Daemon",
      "reason": "GNOME 50 emits this diagnostic on otherwise healthy input-source startup. The release gate separately requires gsd-keyboard to remain alive and the configured Rime source to be readable."
    },
    {
      "id": "gnome50-transient-stack-position",
      "component_regex": "(^|/)gnome-shell($|[|/])",
      "message_regex": "^meta_window_set_stack_position_no_sync: assertion 'window->stack_position >= 0' failed$",
      "conditions": {
        "desktop_release_gate": true
      },
      "max_occurrences": 1,
      "package": "mutter-common",
      "version_glob": "50.*",
      "owner": "GNOME Mutter",
      "reason": "GNOME 50 can emit this transient window-stack diagnostic while the Shell remains healthy. Window activation, extension state, SPICE resize, and the live Shell process remain independent release gates."
    }
  ]
}
